{
  "id": "postImageCard",
  "displayName": "Post Image Card",
  "description": "Displays a post image with the title in front of the image.",
  "category": "Posts",
  "tag": "a",
  "classNames": "flex relative bg-gray-800 items-end rounded overflow-hidden min-h-[180px]",
  "attributes": [
    {
      "type": "function",
      "name": "href",
      "value": "get_the_permalink"
    }
  ],
  "children": [
    {
      "tag": "div",
      "id": "postCardImageWrap",
      "classNames": "absolute inset-0",
      "children": [
        {
          "tag": "img",
          "id": "postImageCardImage",
          "classNames": "absolute left-0 top-0 w-full h-full object-cover object-center",
          "attributes": [
            {
              "type": "function",
              "name": "src",
              "value": "get_the_post_thumbnail_url"
            },
            {
              "type": "function",
              "name": "alt",
              "value": "get_the_title"
            }
          ]
        },
        {
          "tag": "div",
          "id": "postCardImageOverlay",
          "classNames": "bg-black opacity-50 absolute inset-0"
        }
      ]
    },
    {
      "tag": "div",
      "id": "postImageCardContentWrap",
      "classNames": "p-4 relative text-white",
      "children": [
        {
          "tag": "h2",
          "id": "postImageCardHeading",
          "classNames": "font-bold text-3xl",
          "content": {
            "type": "function",
            "value": "get_the_title"
          }
        }
      ]
    }
  ]
}
