{
  "id": "form",
  "displayName": "Form",
  "description": "Collect information from your users.",
  "category": "Data input",
  "tag": "form",
  "classNames": "",
  "scripts": ["gust-forms"],
  "options": [],
  "children": [
    {
      "id": "form-body",
      "tag": "div",
      "classNames": "space-y-6",
      "allowChildren": true
    },
    {
      "id": "form-honeypot",
      "tag": "input",
      "classNames": "opacity-0 h-0 w-0 absolute top-0 left-0",
      "attributes": [
        {
          "type": "value",
          "name": "name",
          "value": "gust_control"
        },
        {
          "type": "value",
          "name": "type",
          "value": "text"
        },
        {
          "type": "value",
          "name": "tabindex",
          "value": "-1"
        },
        {
          "type": "value",
          "name": "autocomplete",
          "value": "off"
        }
      ]
    },
    {
      "id": "form-success",
      "tag": "div",
      "classNames": "bg-success/10 rounded-md p-4 text-success mt-6 gust-form-success hidden",
      "userSelect": true,
      "content": {
        "type": "value",
        "value": "Form submitted successfully, thanks!"
      },
      "editorStyles": {
        "display": "block"
      }
    },
    {
      "id": "form-error",
      "tag": "div",
      "classNames": "bg-error/10 rounded-md p-4 text-error mt-6 gust-form-error hidden",
      "userSelect": true,
      "content": {
        "type": "value",
        "value": "There was an error submitting your response, please try again."
      },
      "editorStyles": {
        "display": "block"
      }
    }
  ]
}
