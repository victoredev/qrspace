      "references": [
        {
          "updates": "attribute",
          "name": "name",
          "type": "option",
          "target": "name"
        },
        {
          "updates": "attribute",
          "name": "id",
          "type": "option",
          "target": "id"
        },
        {
          "updates": "attribute",
          "name": "required",
          "type": "option",
          "target": "required"
        }
      ]
    }
